DATABASE_URL=postgresql://knowledge:change_me@localhost:5432/knowledge?schema=public
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=knowledge
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Empty only for local loopback development; required before exposing the API.
API_TOKEN=
# Set true for hosted installations; startup fails without a strong API token.
REQUIRE_API_TOKEN=false
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
# Official X search only. No paid calls without a configured token and an explicit rule launch/activation.
X_BEARER_TOKEN=
X_DAILY_READ_LIMIT=100
X_AUTO_CARDS_PER_DAY=5
X_EMBEDDINGS_PER_DAY=500
LOG_LEVEL=info
