generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum ProcessingStatus {
  CREATED
  FETCHING
  EXTRACTING
  ANALYZING
  EMBEDDING
  COMPLETED
  FAILED
}
model Source {
  id String @id
  name String
  contents Content[]
}
model Content {
  id String @id @default(uuid()) @db.Uuid
  sourceId String
  source Source @relation(fields: [sourceId], references: [id])
  canonicalKey String? @unique
  externalId String?
  contentHash String @unique
  originalUrl String?
  title String
  author String?
  publishedAt DateTime?
  capturedAt DateTime @default(now())
  text String @db.Text
  language String
  metadata Json
  raw Json
  card KnowledgeCard?
  references SourceReference[]
  jobs ProcessingJob[]
}
model SourceReference {
  id String @id @default(uuid()) @db.Uuid
  contentId String @db.Uuid
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  originalUrl String?
  capturedAt DateTime @default(now())
  metadata Json
}
model KnowledgeCard {
  id String @id @default(uuid()) @db.Uuid
  contentId String @unique @db.Uuid
  content Content @relation(fields: [contentId], references: [id])
  title String
  summary String @db.Text
  language String
  globalScore Float
  activeRevisionId String? @unique @db.Uuid
  processingVersion String
  modelUsed String
  promptVersion String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  topics Topic[]
  concepts Concept[]
  revisions CardAnalysis[]
  jobs ProcessingJob[]
}
model CardAnalysis {
  id String @id @default(uuid()) @db.Uuid
  cardId String @db.Uuid
  card KnowledgeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  analysis Json
  globalScore Float
  provider String
  model String
  promptVersion String
  processingVersion String
  usage Json
  createdAt DateTime @default(now())
  embedding Embedding?
}
model Topic {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  cards KnowledgeCard[]
}
model Concept {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  cards KnowledgeCard[]
}
model Embedding {
  id String @id @default(uuid()) @db.Uuid
  revisionId String @unique @db.Uuid
  revision CardAnalysis @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  provider String
  model String
  vector Unsupported("vector(1536)")
}
model ProcessingJob {
  id String @id @default(uuid()) @db.Uuid
  status ProcessingStatus @default(CREATED)
  input Json
  raw Json?
  discovery Json?
  contentId String? @db.Uuid
  content Content? @relation(fields: [contentId], references: [id])
  cardId String? @db.Uuid
  card KnowledgeCard? @relation(fields: [cardId], references: [id])
  reanalyze Boolean @default(false)
  attempts Int @default(0)
  errorCode String?
  errorMessage String?
  retryable Boolean @default(true)
  leaseUntil DateTime?
  token String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  watchCandidate WatchCandidate?
  xPost XPost?
  @@index([status, leaseUntil])
}

model XRule {
  id String @id @default(uuid()) @db.Uuid
  name String
  query String
  topic String
  mode String @default("recent")
  startTime DateTime?
  endTime DateTime?
  enabled Boolean @default(false)
  intervalMinutes Int @default(120)
  maxPosts Int @default(20)
  autoCards Boolean @default(true)
  nextRunAt DateTime?
  nextToken String?
  sinceId String?
  windowNewestId String?
  archiveComplete Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  runs XCollectionRun[]
}
model XCollectionRun {
  id String @id @default(uuid()) @db.Uuid
  ruleId String @db.Uuid
  rule XRule @relation(fields: [ruleId], references: [id])
  snapshot Json
  page Json?
  status ProcessingStatus @default(CREATED)
  attempts Int @default(0)
  token String? @db.Uuid
  leaseUntil DateTime?
  fetched Int @default(0)
  added Int @default(0)
  errorMessage String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([status, leaseUntil])
}
model XPost {
  id String @id
  text String @db.Text
  quotedText String @default("") @db.Text
  quoteUrl String?
  url String
  authorId String?
  authorHandle String?
  authorName String?
  conversationId String?
  language String @default("und")
  publishedAt DateTime?
  capturedAt DateTime @default(now())
  origin String
  coverage String
  links String[] @default([])
  topics String[] @default([])
  utilitySignal Int @default(0)
  engagement Float?
  momentum Float?
  novelty Float?
  indexStatus ProcessingStatus @default(CREATED)
  indexAttempts Int @default(0)
  indexToken String? @db.Uuid
  indexLeaseUntil DateTime?
  indexError String?
  embeddingProvider String?
  embeddingModel String?
  vector Unsupported("vector(1536)")?
  jobId String? @unique @db.Uuid
  job ProcessingJob? @relation(fields: [jobId], references: [id])
  captures XCapture[]
  observations XObservation[]
  @@index([capturedAt, id])
  @@index([publishedAt, id])
  @@index([indexStatus, indexLeaseUntil])
  @@index([utilitySignal, id])
  @@index([engagement, id])
  @@index([momentum, id])
}
model XCapture {
  id String @id @default(uuid()) @db.Uuid
  postId String
  post XPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  contentHash String
  origin String
  payload Json
  capturedAt DateTime @default(now())
  @@unique([postId, contentHash, origin])
}
model XObservation {
  id String @id @default(uuid()) @db.Uuid
  postId String
  post XPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  metrics Json
  engagement Float
  capturedAt DateTime @default(now())
  @@index([postId, capturedAt])
}
model XUsageDay {
  day DateTime @id @db.Date
  readsReserved Int @default(0)
  cardsReserved Int @default(0)
  embeddingsReserved Int @default(0)
}
model XAnswer {
  id String @id @default(uuid()) @db.Uuid
  cacheKey String @unique
  question String
  mode String
  provider String
  model String
  promptVersion String
  response Json
  sources Json
  createdAt DateTime @default(now())
}

enum WatchRunStatus {
  CREATED
  FETCHING
  COMPLETED
  PARTIAL
  FAILED
}
enum WatchCandidateStatus {
  PENDING
  ACCEPTED
  DISMISSED
}
model WatchSettings {
  id String @id @default("personal")
  topics String[] @default([])
  includeKeywords String[] @default([])
  excludeKeywords String[] @default([])
  languages String[] @default([])
  dailyLimit Int @default(5)
  scheduleEnabled Boolean @default(false)
  nextRunAt DateTime?
  updatedAt DateTime @updatedAt
}
model WatchSource {
  id String @id @default(uuid()) @db.Uuid
  name String
  url String @unique
  enabled Boolean @default(true)
  lastSuccessAt DateTime?
  errorMessage String?
  createdAt DateTime @default(now())
  candidates WatchCandidate[]
}
model WatchRun {
  id String @id @default(uuid()) @db.Uuid
  status WatchRunStatus @default(CREATED)
  trigger String @default("manual")
  settingsSnapshot Json?
  scanned Int @default(0)
  added Int @default(0)
  filtered Int @default(0)
  issues Json @default("[]")
  errorMessage String?
  attempts Int @default(0)
  token String? @db.Uuid
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([status, leaseUntil])
}
model WatchCandidate {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid
  source WatchSource @relation(fields: [sourceId], references: [id])
  url String @unique
  externalId String?
  title String
  excerpt String @db.Text
  author String?
  language String @default("und")
  publishedAt DateTime?
  discoveredAt DateTime @default(now())
  feedSnapshot Json
  selectionScore Float
  reasons String[]
  rankingVersion String
  status WatchCandidateStatus @default(PENDING)
  decision String?
  decidedAt DateTime?
  jobId String? @unique @db.Uuid
  job ProcessingJob? @relation(fields: [jobId], references: [id])
  @@index([status, discoveredAt])
}
